# Local development settings for the backend. Copy to server/.env (never commit it).
# Production settings live in deploy/disconverse/.env (see the .env.example there).

# LiveKit used for voice/video. Development can use your production LiveKit server.
LIVEKIT_URL=wss://rtc.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Keep development out of the production voice rooms: user ids from the dev database would
# otherwise collide with real users' in the shared LiveKit server.
VOICE_ROOM=voice-dev

# ---- Optional ------------------------------------------------------------------------------
# URL the backend uses for the LiveKit API (default: LIVEKIT_URL with ws→http)
# LIVEKIT_API_URL=https://rtc.example.com
# Origin allowed to open the chat WebSocket (the Vite dev server)
# PUBLIC_ORIGIN=http://localhost:5173
# Database folder, and uploaded files (default: DATA_DIR/uploads)
# DATA_DIR=./data
# UPLOADS_DIR=./data/uploads
# Max size per uploaded file, in MB
# MAX_IMAGE_MB=30
# MAX_VIDEO_MB=300
# GIF picker: GIPHY_API_KEY or TENOR_API_KEY, and how strict search is
# GIPHY_API_KEY=
# TENOR_API_KEY=
# GIF_CONTENT_FILTER=medium
