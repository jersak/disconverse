# Disconverse backend + LiveKit settings. Copy to `.env` next to docker-compose.yml on the server
# and fill in. Never commit the real .env.

# ---- Domains (required) --------------------------------------------------------------------
# The web app, and the LiveKit signaling hostname. Both must point at this server, and must
# match APP_DOMAIN / RTC_DOMAIN in the proxy's .env (deploy/proxy/.env.example).
APP_DOMAIN=chat.example.com
RTC_DOMAIN=rtc.example.com

# ---- LiveKit (required) --------------------------------------------------------------------
# Generate with:  openssl rand -hex 8   (key)   /   openssl rand -base64 32   (secret)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Storage (required) --------------------------------------------------------------------
# Host folder for uploaded images/videos (can be a separate, bigger drive). It must contain an
# empty .disconverse-storage file; the backend refuses to start without it, so an unmounted
# drive is noticed instead of uploads silently landing on the wrong disk.
UPLOADS_PATH=/srv/disconverse/uploads

# ---- Upload limits (optional) --------------------------------------------------------------
# Max size per file, in MB.
MAX_IMAGE_MB=30
MAX_VIDEO_MB=300

# ---- GIF search (optional) -----------------------------------------------------------------
# Set ONE of these to enable the GIF picker (Giphy wins if both are set). The key is verified
# at startup; without a working key the GIF button is hidden. GIF links work without a key.
GIPHY_API_KEY=
TENOR_API_KEY=
# How strict GIF search is: off | low | medium | high (strictest)
GIF_CONTENT_FILTER=medium
