# Caddy (reverse proxy) settings. Copy to `.env` next to this docker-compose.yml on the server.
# Caddy gets HTTPS certificates for both hostnames automatically; ports 80 and 443 must reach it.

# Must match APP_DOMAIN / RTC_DOMAIN in deploy/disconverse/.env
APP_DOMAIN=chat.example.com
RTC_DOMAIN=rtc.example.com
